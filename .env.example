# Application Port (Default: 3000)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=production

# Database Configuration (Path to SQLite database file)
# Note: On Vercel serverless deployments, this defaults automatically to /tmp/expenses.db
DB_PATH=expenses.db

# Currency Settings
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
MONTHLY_BUDGET_TARGET=50000
